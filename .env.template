# ---------------------------------------------------------------------------
# Copie este arquivo para `.env` e preencha com os dados da SUA conta Callix.
#
#   cp .env.template .env
#
# O `.env` está no .gitignore e nunca deve ser versionado.
# ---------------------------------------------------------------------------

# Domínio do seu tenant, sem protocolo e sem barra final.
# Vai para o browser (por isso o prefixo NEXT_PUBLIC_).
# Exemplo: suaempresa.callix.com.br
NEXT_PUBLIC_CALLIX_DOMAIN=

# Token de API — SEGREDO, usado apenas no servidor.
# Gere em https://SEU-SUBDOMINIO.callix.com.br/api-tokens escolhendo um perfil
# de acesso com permissão de "gerenciar sessões de usuário".
CALLIX_API_KEY=

# Login do operador Callix que esta aplicação vai representar.
# Atenção: criar a sessão invalida as sessões anteriores desse mesmo login,
# então prefira um usuário de teste em vez do seu próprio.
CALLIX_USERNAME=
